    {
      "chunk_id": "SOP-SEC-02-sec-4",
      "sop_id": "SOP-SEC-02",
      "title": "Ransomware & Destructive Malware Containment Procedure",
      "section": "4.0 Clean Restoration & Validation",
      "content": "- Re-image infected hosts from validated baseline golden images. Never attempt in-place repair for ransomware infections.\n- Restore files from known-good verified air-gapped snapshots prior to infection timestamp.\n- Perform continuous 72-hour endpoint telemetry monitoring post-restoration.",
