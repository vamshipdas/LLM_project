    {
      "chunk_id": "SOP-SEC-01-sec-4",
      "sop_id": "SOP-SEC-01",
      "title": "Phishing & Social Engineering Incident Response Procedure",
      "section": "4.0 Recovery & Post-Incident Review",
      "content": "- Confirm zero active persistence on endpoint before removing network quarantine.\n- Send targeted notification to affected users and submit IoC package to threat intelligence platform (MISP / OpenCTI).",
