# ============================================================================
# Smart Threat Response Assistant - environment configuration
# Copy to `.env` and edit. Every value below is optional: the app runs with
# zero configuration (SQLite + local RAG synthesis) if this file is absent.
# ============================================================================

# --- Security ---------------------------------------------------------------
# REQUIRED in production. Leave empty to generate an ephemeral key at boot
# (tokens then stop validating after a restart - fine for local demos only).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS -------------------------------------------------------------------
# JSON allowlist. Must NOT include "*" when credentials are used.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- LLM provider -----------------------------------------------------------
# auto   -> OpenAI if OPENAI_API_KEY set, else NVIDIA NIM if NVIDIA_API_KEY set,
#           else the deterministic local synthesis engine (no external calls).
# openai | nim | none
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NVIDIA NIM endpoint (OpenAI-compatible). Create a key at build.nvidia.com.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/muse-glimmer-30b
LLM_TIMEOUT_SECONDS=60

# --- RAG / embeddings -------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./data/huggingface
RETRIEVAL_TOP_K=4

# --- Database ---------------------------------------------------------------
# Empty => SQLite at backend/data/soc.db (zero setup).
# Production (synopsis target):
#   postgresql+psycopg://user:password@localhost:5432/soc_assistant
DATABASE_URL=

# --- Seed demo accounts -----------------------------------------------------
# Created on first boot. CHANGE THESE before any shared deployment.
SEED_ADMIN_PASSWORD=adminpassword123
SEED_ANALYST_PASSWORD=socpassword123

# --- Critical Alert Email Notifications (SMTP) -------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vamshipdas@gmail.com
SMTP_PASSWORD=<GMAIL_APP_PASSWORD>
ALERT_EMAIL_FROM=vamshipdas@gmail.com
ALERT_EMAIL_TO=dasvamshi8@gmail.com
ALERT_EMAIL_ENABLED=true
ALERT_MIN_SEVERITY=critical
ALERT_COOLDOWN_SECONDS=300
DASHBOARD_BASE_URL=http://localhost:5173

